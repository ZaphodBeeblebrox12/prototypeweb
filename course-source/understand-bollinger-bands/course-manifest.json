  "course": {
    "title": "Understand Bollinger Bands",
    "slug": "understand-bollinger-bands",
    "summary": "Read Bollinger Bands in context, compare documented methods, and make conditional trading plans without treating an indicator as a signal.",
    "description": "A practical, evidence-led course on band construction, market context, signature patterns, documented methods, failure cases and risk. The course teaches observation, interpretation and conditional testing; it does not provide trading signals.",
    "position": 20
  },
  "notebook": {
    "title": "Make the reading conditional",
    "prompts": [
      {
        "label": "Describe",
        "text": "Where is price relative to the bands and middle line? State only what is visible."
      },
      {
        "label": "Interpret",
        "text": "Does the structure look like a trend, a range or a transition? Name a reasonable alternative."
      },
      {
        "label": "Test",
        "text": "What future price behaviour would strengthen or weaken your reading?"
      }
    ]
  },
