+++ b/tradethesis_verification_bridge.py
@@ -0,0 +1,199 @@
+"""Signed forwarding bridge for TradeThesis Telegram deep-link verification.
+
+Required environment variables in the running bot process:
+  TRADETHESIS_TELEGRAM_WEBHOOK_URL=https://<staging-host>/bot/telegram/webhook/
+  PROVISION_SHARED_SECRET=<same secret configured in Django>
+
+No request body, /start token, signature, or secret is written to logs.
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import hmac
+import json
+import logging
+import os
+import secrets
+import time
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlsplit
+from urllib.request import HTTPRedirectHandler, Request, build_opener
+from typing import Any
+
+logger = logging.getLogger(__name__)
+DEFAULT_TIMEOUT_SECONDS = 10
+
+
+class _NoRedirectHandler(HTTPRedirectHandler):
+    """Do not forward a verification token to an unconfigured redirect host."""
+
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+_NO_REDIRECT_OPENER = build_opener(_NoRedirectHandler())
+
+
+def build_signed_request(
+    update_payload: dict[str, Any],
+    secret: str,
+    *,
+    timestamp: str | None = None,
+    nonce: str | None = None,
+) -> tuple[bytes, dict[str, str]]:
+    """Return the exact JSON body and HMAC headers expected by Django."""
+    if not secret:
+        raise ValueError("A shared secret is required")
+
+    body = json.dumps(
+        update_payload,
+        separators=(",", ":"),
+        ensure_ascii=False,
+    ).encode("utf-8")
+    ts = timestamp or str(int(time.time()))
+    request_nonce = nonce or secrets.token_urlsafe(18)
+    signed_prefix = f"{ts}.{request_nonce}.".encode("utf-8")
+    signature = hmac.new(
+        secret.encode("utf-8"), signed_prefix + body, hashlib.sha256
+    ).hexdigest()
+    return body, {
+        "Content-Type": "application/json",
+        "X-Bot-Timestamp": ts,
+        "X-Bot-Nonce": request_nonce,
+        "X-Bot-Signature": signature,
+    }
+
+
+def _url_is_safe(url: str) -> bool:
+    try:
+        parsed = urlsplit(url)
+    except ValueError:
+        return False
+    if not parsed.hostname or parsed.username or parsed.password:
+        return False
+    if parsed.scheme == "https":
+        return True
+    # Allow plain HTTP only for local, offline tests/local development.
+    return parsed.scheme == "http" and parsed.hostname in {"127.0.0.1", "localhost", "::1"}
+
+
+def _post_signed(url: str, body: bytes, headers: dict[str, str], timeout: int) -> bool:
+    request = Request(url, data=body, headers=headers, method="POST")
+    try:
+        with _NO_REDIRECT_OPENER.open(request, timeout=timeout) as response:
+            status_code = response.status
+            # Consume the small response body so the connection can be released.
+            response.read(16_384)
+    except HTTPError as exc:
+        status_code = exc.code
+        try:
+            exc.read(16_384)
+        except Exception:
+            pass
+    except (URLError, TimeoutError, OSError) as exc:
+        logger.warning(
+            "TradeThesis Telegram verification forward failed (%s)",
+            type(exc).__name__,
+        )
+        return False
+    except Exception as exc:  # defensive: never crash the Telegram poller
+        logger.warning(
+            "TradeThesis Telegram verification forward failed (%s)",
+            type(exc).__name__,
+        )
+        return False
+
+    if 200 <= status_code < 300:
+        # Django sends the user-facing result message. Any 2xx means the update
+        # reached that handler; it may legitimately report an expired/invalid token.
+        return True
+    logger.warning(
+        "TradeThesis Telegram verification endpoint returned HTTP %s", status_code
+    )
+    return False
+
+
+def telegram_update_payload(update: Any) -> dict[str, Any]:
+    """Build a small JSON-safe Telegram Update envelope Django consumes.
+
+    A minimal envelope avoids accidentally passing library datetime objects or
+    unrelated update fields into JSON serialization. It still contains every
+    field the Django verification handler reads.
+    """
+    message = getattr(update, "effective_message", None)
+    if message is None or not getattr(message, "text", None):
+        raise ValueError("A text Telegram message is required")
+    chat = getattr(message, "chat", None)
+    sender = getattr(message, "from_user", None)
+    if chat is None or sender is None:
+        raise ValueError("Telegram message is missing chat or sender")
+
+    message_date = getattr(message, "date", None)
+    date_timestamp = int(message_date.timestamp()) if message_date else int(time.time())
+    sender_payload: dict[str, Any] = {
+        "id": sender.id,
+        "is_bot": bool(getattr(sender, "is_bot", False)),
+        "first_name": getattr(sender, "first_name", "") or "",
+    }
+    for field in ("last_name", "username", "language_code"):
+        value = getattr(sender, field, None)
+        if value:
+            sender_payload[field] = value
+
+    message_payload: dict[str, Any] = {
+        "message_id": getattr(message, "message_id", 0) or 0,
+        "date": date_timestamp,
+        "chat": {
+            "id": chat.id,
+            "type": getattr(chat, "type", "private") or "private",
+        },
+        "from": sender_payload,
+        "text": message.text,
+    }
+    return {
+        "update_id": getattr(update, "update_id", 0) or 0,
+        "message": message_payload,
+    }
+
+
+async def forward_telegram_verification(update: Any) -> bool:
+    """Forward a Telegram Update for /start verify_<token> to Django.
+
+    Django validates the one-time token and sends the user's success/error reply.
+    """
+    endpoint = (os.getenv("TRADETHESIS_TELEGRAM_WEBHOOK_URL") or "").strip()
+    secret = os.getenv("PROVISION_SHARED_SECRET") or ""
+    if not endpoint or not secret:
+        missing = []
+        if not endpoint:
+            missing.append("TRADETHESIS_TELEGRAM_WEBHOOK_URL")
+        if not secret:
+            missing.append("PROVISION_SHARED_SECRET")
+        logger.error(
+            "Telegram verification forwarding is disabled; missing configuration: %s",
+            ", ".join(missing),
+        )
+        return False
+    if not _url_is_safe(endpoint):
+        logger.error(
+            "Telegram verification endpoint must use HTTPS (HTTP is allowed only on localhost)"
+        )
+        return False
+
+    try:
+        body, headers = build_signed_request(telegram_update_payload(update), secret)
+    except Exception as exc:
+        logger.warning(
+            "Unable to prepare TradeThesis verification request (%s)",
+            type(exc).__name__,
+        )
+        return False
+
+    try:
+        timeout = max(1, int(os.getenv("TRADETHESIS_TELEGRAM_WEBHOOK_TIMEOUT", "10")))
+    except ValueError:
+        timeout = DEFAULT_TIMEOUT_SECONDS
+
+    # urllib is synchronous; keep it off the bot's event loop.
+    return await asyncio.to_thread(_post_signed, endpoint, body, headers, timeout)
