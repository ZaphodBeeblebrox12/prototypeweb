+import asyncio
+import hashlib
+import hmac
+import json
+import os
+import threading
+import unittest
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from unittest.mock import patch
+
+from tradethesis_verification_bridge import (
+    build_signed_request,
+    forward_telegram_verification,
+)
+
+
+class FakeChat:
+    id = 321
+    type = "private"
+
+
+class FakeUser:
+    id = 321
+    is_bot = False
+    first_name = "Test"
+    last_name = "User"
+    username = "test_user"
+    language_code = "en"
+
+
+class FakeMessage:
+    def __init__(self, text):
+        self.text = text
+        self.chat = FakeChat()
+        self.from_user = FakeUser()
+        self.message_id = 3
+        self.date = None
+
+
+class FakeUpdate:
+    def __init__(self, text="/start verify_one-time-token", update_id=123):
+        self.update_id = update_id
+        self.effective_message = FakeMessage(text)
+
+
+class RequestCaptureHandler(BaseHTTPRequestHandler):
+    captured = None
+    response_code = 200
+    redirect_location = None
+    redirect_followed = False
+
+    def do_POST(self):
+        body = self.rfile.read(int(self.headers.get("Content-Length", "0")))
+        RequestCaptureHandler.captured = {
+            "path": self.path,
+            "body": body,
+            "timestamp": self.headers.get("X-Bot-Timestamp"),
+            "nonce": self.headers.get("X-Bot-Nonce"),
+            "signature": self.headers.get("X-Bot-Signature"),
+        }
+        # If urllib follows a redirect, mark the second request and return 200.
+        if self.path == "/redirect-target":
+            RequestCaptureHandler.redirect_followed = True
+            status_code = 200
+        else:
+            status_code = RequestCaptureHandler.response_code
+        self.send_response(status_code)
+        self.send_header("Content-Type", "application/json")
+        if RequestCaptureHandler.redirect_location and self.path != "/redirect-target":
+            self.send_header("Location", RequestCaptureHandler.redirect_location)
+        self.end_headers()
+        self.wfile.write(b'{"ok":true}')
+
+    def log_message(self, *args):
+        pass
+
+
+class TelegramVerificationBridgeTests(unittest.TestCase):
+    def test_signature_matches_django_contract(self):
+        payload = {"update_id": 10, "message": {"text": "/start verify_secret-token"}}
+        secret = "test-shared-secret"
+        body, headers = build_signed_request(
+            payload, secret, timestamp="1700000000", nonce="fixed-nonce"
+        )
+        expected = hmac.new(
+            secret.encode(),
+            b"1700000000.fixed-nonce." + body,
+            hashlib.sha256,
+        ).hexdigest()
+        self.assertEqual(headers["X-Bot-Signature"], expected)
+        self.assertEqual(json.loads(body), payload)
+        self.assertEqual(headers["Content-Type"], "application/json")
+
+    def test_forwarding_sends_native_update_with_hmac_headers(self):
+        RequestCaptureHandler.captured = None
+        RequestCaptureHandler.response_code = 200
+        server = HTTPServer(("127.0.0.1", 0), RequestCaptureHandler)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            with patch.dict(os.environ, {
+                "TRADETHESIS_TELEGRAM_WEBHOOK_URL": f"http://127.0.0.1:{server.server_port}/bot/telegram/webhook/",
+                "PROVISION_SHARED_SECRET": "local-test-secret",
+                "TRADETHESIS_TELEGRAM_WEBHOOK_TIMEOUT": "2",
+            }, clear=False):
+                forwarded = asyncio.run(forward_telegram_verification(FakeUpdate()))
+            self.assertTrue(forwarded)
+            captured = RequestCaptureHandler.captured
+            self.assertIsNotNone(captured)
+            self.assertEqual(captured["path"], "/bot/telegram/webhook/")
+            actual_payload = json.loads(captured["body"])
+            self.assertEqual(actual_payload["update_id"], 123)
+            self.assertEqual(actual_payload["message"]["text"], "/start verify_one-time-token")
+            self.assertEqual(actual_payload["message"]["chat"], {"id": 321, "type": "private"})
+            expected = hmac.new(
+                b"local-test-secret",
+                f'{captured["timestamp"]}.{captured["nonce"]}.'.encode() + captured["body"],
+                hashlib.sha256,
+            ).hexdigest()
+            self.assertEqual(captured["signature"], expected)
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join(timeout=2)
+
+    def test_missing_configuration_fails_closed(self):
+        with patch.dict(os.environ, {
+            "TRADETHESIS_TELEGRAM_WEBHOOK_URL": "",
+            "PROVISION_SHARED_SECRET": "",
+        }, clear=False):
+            self.assertFalse(asyncio.run(forward_telegram_verification(FakeUpdate())))
+
+    def test_non_local_http_endpoint_fails_closed(self):
+        with patch.dict(os.environ, {
+            "TRADETHESIS_TELEGRAM_WEBHOOK_URL": "http://example.com/bot/telegram/webhook/",
+            "PROVISION_SHARED_SECRET": "local-test-secret",
+        }, clear=False):
+            self.assertFalse(asyncio.run(forward_telegram_verification(FakeUpdate())))
+
+
+    def test_redirect_response_is_not_followed(self):
+        RequestCaptureHandler.captured = None
+        RequestCaptureHandler.redirect_followed = False
+        RequestCaptureHandler.redirect_location = "/redirect-target"
+        RequestCaptureHandler.response_code = 307
+        server = HTTPServer(("127.0.0.1", 0), RequestCaptureHandler)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            with patch.dict(os.environ, {
+                "TRADETHESIS_TELEGRAM_WEBHOOK_URL": f"http://127.0.0.1:{server.server_port}/bot/telegram/webhook/",
+                "PROVISION_SHARED_SECRET": "local-test-secret",
+                "TRADETHESIS_TELEGRAM_WEBHOOK_TIMEOUT": "2",
+            }, clear=False):
+                self.assertFalse(asyncio.run(forward_telegram_verification(FakeUpdate(update_id=7))))
+            self.assertFalse(RequestCaptureHandler.redirect_followed)
+            self.assertEqual(RequestCaptureHandler.captured["path"], "/bot/telegram/webhook/")
+        finally:
+            RequestCaptureHandler.redirect_location = None
+            server.shutdown()
+            server.server_close()
+            thread.join(timeout=2)
+
+    def test_non_2xx_response_is_not_reported_as_forwarded(self):
+        RequestCaptureHandler.captured = None
+        RequestCaptureHandler.response_code = 401
+        server = HTTPServer(("127.0.0.1", 0), RequestCaptureHandler)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            with patch.dict(os.environ, {
+                "TRADETHESIS_TELEGRAM_WEBHOOK_URL": f"http://127.0.0.1:{server.server_port}/bot/telegram/webhook/",
+                "PROVISION_SHARED_SECRET": "local-test-secret",
+                "TRADETHESIS_TELEGRAM_WEBHOOK_TIMEOUT": "2",
+            }, clear=False):
+                self.assertFalse(asyncio.run(forward_telegram_verification(FakeUpdate(update_id=1))))
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join(timeout=2)
+
+
+if __name__ == "__main__":
+    unittest.main()
