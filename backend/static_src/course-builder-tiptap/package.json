{
  "name": "tradethesis-course-builder-tiptap",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted isolated Tiptap prototype for TradeThesis Course Builder",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --legal-comments=none --format=iife --target=es2020 --outfile=../../static/academy/course-builder-tiptap.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/markdown": "3.32.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  },
  "type": "module"
}
