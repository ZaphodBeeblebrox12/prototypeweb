DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///db.sqlite3
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
# Must match PROVISION_SHARED_SECRET configured in the existing Telegram bot process.
PROVISION_SHARED_SECRET=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Public URL used for checkout returns and invoice links.
SITE_BASE_URL=http://127.0.0.1:8000

# Durable Course Builder image storage. In staging/production, new image writes
# require Google Drive or a token that can write contents to the configured repository.
# Canonical ACADEMY_* names are preferred; selected unprefixed aliases are also supported.
ACADEMY_REQUIRE_DURABLE_ASSETS=True
ACADEMY_GITHUB_ASSET_TOKEN=
ACADEMY_GITHUB_ASSET_PATH_PREFIX=course-assets
ACADEMY_GOOGLE_DRIVE_CLIENT_ID=
ACADEMY_GOOGLE_DRIVE_CLIENT_SECRET=
ACADEMY_GOOGLE_DRIVE_REDIRECT_URI=
ACADEMY_GOOGLE_DRIVE_REFRESH_TOKEN=
ACADEMY_GOOGLE_DRIVE_ASSET_FOLDER_ID=
ACADEMY_GOOGLE_DRIVE_SOURCE_FOLDER_ID=
# Uploads use private provider APIs; image files are never placed in public MEDIA_ROOT.

# Optional YouTube Data API v3 settings for the sitewide LIVE pill.
# These are server-side only; never place the API key in site/assets.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Payments: use test credentials for local/staging tests.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email: configure these before public signup/sales.
# On Render, add these as Environment variables; do not commit real secrets.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=payments@example.com
EMAIL_HOST_PASSWORD=replace-with-a-secret
DEFAULT_FROM_EMAIL=TradeThesis <payments@example.com>

# Render Free blocks outbound SMTP. For hosted signup/password-recovery mail,
# use Resend HTTPS after verifying the sender address/domain with the provider:
# EMAIL_BACKEND=apps.core.email_backends.ResendEmailBackend
# RESEND_API_KEY=
# RESEND_API_TIMEOUT=10
