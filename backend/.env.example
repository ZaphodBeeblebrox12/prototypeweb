DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///db.sqlite3
# Legacy environment values for a separate publisher process, if used.
# Django's verification/membership bot is configured in the database via BotConfig.
TELEGRAM_BOT_TOKEN=your-publisher-bot-token
TELEGRAM_BOT_USERNAME=your_publisher_bot_username
# Set a unique Telegram-valid secret before using the native webhook.
TELEGRAM_WEBHOOK_SECRET=
# Legacy bridge only (registration and rollback while migration is verified).
PROVISION_SHARED_SECRET=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Public URL used for checkout returns and invoice links.
SITE_BASE_URL=http://127.0.0.1:8000

# Durable Course Builder image storage. Hosted deployments default to requiring a
# remote durable provider. Override ACADEMY_REQUIRE_DURABLE_ASSETS=False only when the
# private media root is on a persistent mounted disk. Never use the default ephemeral disk.
# Canonical ACADEMY_* names are preferred; selected unprefixed aliases are also supported.
ACADEMY_GITHUB_ASSET_TOKEN=
ACADEMY_GITHUB_ASSET_PATH_PREFIX=course-assets
ACADEMY_GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
ACADEMY_GOOGLE_DRIVE_CLIENT_ID=
ACADEMY_GOOGLE_DRIVE_CLIENT_SECRET=
ACADEMY_GOOGLE_DRIVE_REDIRECT_URI=
ACADEMY_GOOGLE_DRIVE_REFRESH_TOKEN=
ACADEMY_GOOGLE_DRIVE_ASSET_FOLDER_ID=
ACADEMY_GOOGLE_DRIVE_SOURCE_FOLDER_ID=
# Uploads use private provider APIs; image files are never placed in public MEDIA_ROOT.

# Optional YouTube Data API v3 settings for the sitewide LIVE pill.
# These are server-side only; never place the API key in site/assets.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Payments: use test credentials for local/staging tests.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email: configure these before public signup/sales.
# On Render, add these as Environment variables; do not commit real secrets.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=payments@example.com
EMAIL_HOST_PASSWORD=replace-with-a-secret
DEFAULT_FROM_EMAIL=TradeThesis <payments@example.com>

# Render Free blocks outbound SMTP. For hosted signup/password-recovery mail,
# use Resend HTTPS after verifying the sender address/domain with the provider:
# EMAIL_BACKEND=apps.core.email_backends.ResendEmailBackend
# RESEND_API_KEY=
# RESEND_API_TIMEOUT=10

# Optional comma-separated staff inboxes for new public course enquiries.
# Keep empty until a monitored team address is configured in the hosting environment.
PROSPECT_ENQUIRY_RECIPIENTS=


# Provider-neutral course asset storage. Keep Google Drive selected until verified cutover.
ACADEMY_ASSET_STORAGE_BACKEND=google_drive
ACADEMY_ASSET_STORAGE_ALIAS=academy_assets
ACADEMY_ASSET_STORAGE_DURABLE=False
ACADEMY_ASSET_STORAGE_LABEL=
# Configure a future provider as a Django Storage backend via protected host env settings.
ACADEMY_ASSET_STORAGE_BACKEND_CLASS=
ACADEMY_ASSET_STORAGE_OPTIONS={}
ACADEMY_ASSET_MIGRATION_TARGET_ALIAS=
# Set True only after confirming the target provider is persistent durable storage.
ACADEMY_ASSET_MIGRATION_TARGET_DURABLE=False
