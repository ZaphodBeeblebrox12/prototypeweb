# TradeThesis Academy environment template.
# Copy to backend/.env for local use. Never commit backend/.env or real credentials.
# Django reads this file from backend/.env via config/settings/base.py.

DJANGO_SETTINGS_MODULE=config.settings.base
DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_BASE_URL=http://127.0.0.1:8000

# Optional for local development. If unset, the base settings use local SQLite.
# For hosted staging, use a PostgreSQL URI from the Supabase Session Pooler.
# Never put a real database password in this template.
# DATABASE_URL=postgresql://postgres:REPLACE_ME@POOLER_HOST:6543/postgres

PYTHON_VERSION=3.12
WEB_CONCURRENCY=2

# Telegram integration (leave empty until configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CONTROL_CHANNEL_ID=
PROVISION_SHARED_SECRET=
PROVISION_BOT_URL=

# Payment providers (use test-mode credentials for staging)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MAXMIND_ENABLED=False

# Local email stays in the console. Render staging uses Resend's HTTPS API.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
RESEND_API_TIMEOUT=10
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Optional Supabase JS/API integration only. These are not used by Django's
# PostgreSQL connection, which uses DATABASE_URL. The publishable key is a
# browser/client key; never put a Supabase database password here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional ONE-TIME Render Free staging admin bootstrap.
# Keep disabled/blank except during the deliberate bootstrap deploy.
# After success, remove these temporary variables from Render Environment Group.
BOOTSTRAP_STAGING_ADMIN=False
STAGING_ADMIN_USERNAME=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
